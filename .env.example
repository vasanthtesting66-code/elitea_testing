# OrangeHRM Application Configuration
BASE_URL=https://opensource-demo.orangehrmlive.com

# Valid Credentials
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Invalid Credentials (used for negative tests)
INVALID_USERNAME=InvalidUser123
INVALID_PASSWORD=wrongpassword
CASE_SENSITIVE_PASSWORD=Admin123

# Protected URLs
DASHBOARD_URL=/web/index.php/dashboard/index
LOGIN_URL=/web/index.php/auth/login
PIM_URL=/web/index.php/pim/viewPimModule

# Test Timeouts (ms)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
