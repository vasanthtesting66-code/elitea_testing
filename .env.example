# ============================================================
# OrangeHRM Playwright Automation – Environment Configuration
# Copy this file to .env and populate with real values.
# NEVER commit .env to source control.
# ============================================================

# Application Base URL
BASE_URL=https://opensource-demo.orangehrmlive.com

# Valid admin credentials
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Invalid / test credentials
INVALID_USERNAME=InvalidUser
INVALID_PASSWORD=wrongpassword
LOWERCASE_USERNAME=admin

# Application paths
LOGIN_PATH=/web/index.php/auth/login
DASHBOARD_PATH=/web/index.php/dashboard/index

# Test execution environment
ENVIRONMENT=demo
HEADLESS=true
BROWSER=chromium

# Timeouts (milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=10000
