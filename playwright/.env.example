# ─── Application ───────────────────────────────────────────────────────────────
BASE_URL=https://your-app-domain.com

# ─── Test Credentials ──────────────────────────────────────────────────────────
# Account that is registered, activated, and NOT currently locked.
TEST_USER_EMAIL=testuser@example.com
TEST_USER_VALID_PASSWORD=ValidPassword123
TEST_USER_WRONG_PASSWORD=WrongPassword999

# ─── Lockout Policy ────────────────────────────────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=3

# ─── Cloudflare Turnstile ──────────────────────────────────────────────────────
# Provide a test/bypass token issued by Cloudflare for non-production environments.
CAPTCHA_BYPASS_TOKEN=
